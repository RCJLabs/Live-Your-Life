{
  "//": "Tests run in Node and may use its APIs, so they are typechecked here rather than under the pure package configs (as in Engine-Builder).",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "packages/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "apps/**/*.test.ts",
    "apps/*/e2e/**/*.ts",
    "playwright.config.ts",
    "tools/**/*.test.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "engine"]
}
