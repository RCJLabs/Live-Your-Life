{
  "name": "live-your-life",
  "private": true,
  "version": "0.0.1",
  "description": "A life sim in a fictional Rust Belt city: isometric, drawn in code, for the browser and Google Play.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @lyl/game dev",
    "build": "pnpm --filter @lyl/game build",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' --filter './tools/**' --if-present typecheck && tsc -p tsconfig.tests.json",
    "lint": "biome check . && node tools/purity/src/cli.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
