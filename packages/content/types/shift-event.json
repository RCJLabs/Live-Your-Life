{
  "title": "Shift event",
  "description": "Something that happens on a shift and stops it for a choice (D40), drawn by tag from a pool careers share. Its words are drafts for the voice pass (docs/VOICE.md).",
  "nameField": "name",
  "fields": {
    "name": {
      "kind": "text",
      "min": 1,
      "max": 40
    },
    "tags": {
      "kind": "list",
      "min": 1,
      "of": {
        "kind": "text",
        "min": 1,
        "max": 24
      },
      "description": "A career draws it when they share a tag."
    },
    "weight": {
      "kind": "int",
      "min": 1,
      "max": 100,
      "description": "How likely it is against the others drawn with it."
    },
    "when": {
      "kind": "condition",
      "optional": true,
      "description": "It is drawn only while this holds."
    },
    "prompt": {
      "kind": "text",
      "min": 1,
      "max": 400,
      "multiline": true,
      "description": "What happens, to you, now."
    },
    "choices": {
      "kind": "list",
      "min": 2,
      "max": 4,
      "description": "What you can do. Certain choices come before chancy ones.",
      "of": {
        "kind": "group",
        "fields": {
          "id": {
            "kind": "text",
            "min": 1,
            "max": 24
          },
          "text": {
            "kind": "text",
            "min": 1,
            "max": 120
          },
          "odds": {
            "kind": "group",
            "optional": true,
            "description": "Without odds it is certain. With them: the base chance in percent, the points added at full skill, and the points taken away when exhausted, kept between 5 and 95.",
            "fields": {
              "base": {
                "kind": "int",
                "min": 0,
                "max": 100
              },
              "skill": {
                "kind": "int",
                "min": 0,
                "max": 100
              },
              "tired": {
                "kind": "int",
                "min": 0,
                "max": 100
              },
              "regard": {
                "kind": "int",
                "optional": true,
                "min": 0,
                "max": 100,
                "description": "For a choice that leans on the person beside you (D43): added at their full regard, taken away at none."
              }
            }
          },
          "outcome": {
            "kind": "group",
            "description": "What follows: always, or when the odds come up.",
            "fields": {
              "told": {
                "kind": "text",
                "min": 1,
                "max": 300,
                "multiline": true
              },
              "standing": {
                "kind": "int",
                "optional": true,
                "min": -30,
                "max": 30
              },
              "practice": {
                "kind": "int",
                "optional": true,
                "min": 0,
                "max": 600,
                "description": "Minutes of practice it is worth."
              },
              "home": {
                "kind": "bool",
                "optional": true,
                "description": "Sent home, with nothing lost for the rest of the shift."
              },
              "needs": {
                "kind": "map",
                "optional": true,
                "key": {
                  "kind": "enum",
                  "values": ["rest", "food", "hygiene", "company", "calm", "health"]
                },
                "of": {
                  "kind": "int",
                  "min": -50,
                  "max": 50
                },
                "description": "Points each need gains or loses."
              },
              "act": {
                "kind": "ref",
                "to": "act",
                "optional": true,
                "description": "What the person beside you remembers of it (D42)."
              },
              "arrest": {
                "kind": "ref",
                "to": "offence",
                "optional": true,
                "description": "An arrest made, charged as this offence (M2.4): the police career's work, on the same offences the law charges you with."
              }
            }
          },
          "failure": {
            "kind": "group",
            "optional": true,
            "description": "What follows when the odds don't come up. A choice has it exactly when it has odds.",
            "fields": {
              "told": {
                "kind": "text",
                "min": 1,
                "max": 300,
                "multiline": true
              },
              "standing": {
                "kind": "int",
                "optional": true,
                "min": -30,
                "max": 30
              },
              "practice": {
                "kind": "int",
                "optional": true,
                "min": 0,
                "max": 600
              },
              "home": {
                "kind": "bool",
                "optional": true
              },
              "needs": {
                "kind": "map",
                "optional": true,
                "key": {
                  "kind": "enum",
                  "values": ["rest", "food", "hygiene", "company", "calm", "health"]
                },
                "of": {
                  "kind": "int",
                  "min": -50,
                  "max": 50
                }
              },
              "act": {
                "kind": "ref",
                "to": "act",
                "optional": true
              },
              "arrest": {
                "kind": "ref",
                "to": "offence",
                "optional": true,
                "description": "An arrest made, charged as this offence (M2.4): the police career's work, on the same offences the law charges you with."
              }
            }
          }
        }
      }
    }
  }
}
