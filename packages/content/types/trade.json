{
  "title": "Trade",
  "description": "Selling a controlled substance on the street (D78, D82): whom you buy from and at what weights and prices, what a sale is, when buyers come to the corner, who sees, the heat it draws, and what holding and selling are charged as. The figures trace to CALIBRATION.md.",
  "nameField": "name",
  "fields": {
    "name": {
      "kind": "text",
      "min": 1,
      "max": 60
    },
    "names": {
      "kind": "ref",
      "to": "name-pool",
      "description": "Whom the supplier is drawn from."
    },
    "supplier": {
      "kind": "group",
      "description": "When the supplier can be found, and what they sell: a weight in tenths of a gram for a price in cents.",
      "fields": {
        "hours": {
          "kind": "group",
          "fields": {
            "from": {
              "kind": "int",
              "min": 0,
              "max": 23
            },
            "to": {
              "kind": "int",
              "min": 1,
              "max": 24
            }
          }
        },
        "sells": {
          "kind": "list",
          "min": 1,
          "of": {
            "kind": "group",
            "fields": {
              "id": {
                "kind": "text",
                "min": 1,
                "max": 24
              },
              "grams": {
                "kind": "int",
                "min": 1,
                "max": 10000
              },
              "price": {
                "kind": "int",
                "min": 1
              }
            }
          }
        }
      }
    },
    "sale": {
      "kind": "group",
      "description": "What one buyer takes, in tenths of a gram, and pays, in cents.",
      "fields": {
        "grams": {
          "kind": "int",
          "min": 1,
          "max": 100
        },
        "price": {
          "kind": "int",
          "min": 1
        }
      }
    },
    "corner": {
      "kind": "group",
      "description": "The corner where buyers come: in each hour of the day, the odds in percent that a buyer comes in each ten minutes; and of the town's people out on the street that hour, how many in a thousand pass the corner.",
      "fields": {
        "buyers": {
          "kind": "list",
          "min": 24,
          "max": 24,
          "of": {
            "kind": "int",
            "min": 0,
            "max": 95
          }
        },
        "passing": {
          "kind": "int",
          "min": 0,
          "max": 1000
        }
      }
    },
    "seen": {
      "kind": "group",
      "description": "The odds in percent a sale is seen and told of: a base, more for each person passing, in tenths of a percent, and more for heat, one percent for so many points; never above the most (tune).",
      "fields": {
        "base": {
          "kind": "int",
          "min": 0,
          "max": 95
        },
        "witness": {
          "kind": "int",
          "min": 0,
          "max": 100
        },
        "per": {
          "kind": "int",
          "min": 1,
          "max": 100
        },
        "most": {
          "kind": "int",
          "min": 1,
          "max": 95
        }
      }
    },
    "heat": {
      "kind": "group",
      "description": "The police's attention to the corner and to you: points for a sale and for one seen, and what is kept of them each day, in ten-thousandths (tune).",
      "fields": {
        "sale": {
          "kind": "int",
          "min": 0,
          "max": 100
        },
        "seen": {
          "kind": "int",
          "min": 0,
          "max": 100
        },
        "keep": {
          "kind": "int",
          "min": 1,
          "max": 9999
        }
      }
    },
    "possession": {
      "kind": "list",
      "min": 1,
      "of": {
        "kind": "ref",
        "to": "offence"
      },
      "description": "What holding it is charged as: the first whose weight covers what you hold, and your record."
    },
    "delivery": {
      "kind": "list",
      "min": 1,
      "of": {
        "kind": "ref",
        "to": "offence"
      },
      "description": "What selling it, or holding it to sell, is charged as: the first whose weight covers it, and your record."
    },
    "police": {
      "kind": "group",
      "description": "When the police act on what was seen (D46: at a time you are told): how many sales seen make a case, and days until they come for you.",
      "fields": {
        "enough": {
          "kind": "int",
          "min": 1,
          "max": 50
        },
        "raid": {
          "kind": "group",
          "fields": {
            "min": {
              "kind": "int",
              "min": 1,
              "max": 60
            },
            "max": {
              "kind": "int",
              "min": 1,
              "max": 60
            }
          }
        }
      }
    },
    "bail": {
      "kind": "group",
      "description": "Bail at arraignment: the bond in cents, the share of it in percent you post to go home (MCL 765.6), and the hour of the morning the court sees the night's arrests.",
      "fields": {
        "bond": {
          "kind": "int",
          "min": 0
        },
        "posted": {
          "kind": "int",
          "min": 1,
          "max": 100
        },
        "hour": {
          "kind": "int",
          "min": 0,
          "max": 23
        }
      }
    },
    "court": {
      "kind": "group",
      "fields": {
        "min": {
          "kind": "int",
          "min": 1,
          "max": 180
        },
        "max": {
          "kind": "int",
          "min": 1,
          "max": 180
        }
      },
      "description": "Days from the arrest to the court date."
    },
    "contest": {
      "kind": "group",
      "description": "The odds in percent a not-guilty plea ends in dismissal, by the evidence: sales seen only, or the drugs found on you.",
      "fields": {
        "seen": {
          "kind": "int",
          "min": 1,
          "max": 95
        },
        "found": {
          "kind": "int",
          "min": 1,
          "max": 95
        }
      }
    },
    "crew": {
      "kind": "group",
      "description": "The supplier's crew (D79, D84–D86): the trust and the heat they want before they bring you in; what they front, at what price, due in how many days; trust lost when a front goes unpaid; and a recruit's terms (tune).",
      "fields": {
        "trust": {
          "kind": "int",
          "min": 1,
          "max": 50,
          "description": "Purchases or repayments before they'll bring you in."
        },
        "heat": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "The most heat on you they'll take."
        },
        "front": {
          "kind": "group",
          "fields": {
            "lot": {
              "kind": "text",
              "min": 1,
              "max": 24
            },
            "price": {
              "kind": "int",
              "min": 1,
              "max": 10000000
            },
            "days": {
              "kind": "int",
              "min": 1,
              "max": 60
            }
          }
        },
        "unpaid": {
          "kind": "int",
          "min": 0,
          "max": 50,
          "description": "Trust lost for a front not paid back on time."
        },
        "recruit": {
          "kind": "group",
          "fields": {
            "regard": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The coworker's regard needed for a yes."
            },
            "familiarity": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "How well you must know them."
            },
            "nights": {
              "kind": "int",
              "min": 1,
              "max": 7,
              "description": "Nights a week they sell."
            },
            "buyers": {
              "kind": "int",
              "min": 1,
              "max": 95,
              "description": "The odds in percent of a buyer in each of their ten minutes, through a night's four hours."
            },
            "share": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Percent of their takings they keep."
            },
            "seen": {
              "kind": "int",
              "min": 1,
              "max": 95,
              "description": "The odds in percent one of their sales is seen."
            },
            "named": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The odds in percent they name you once arrested, at a regard of 0; less, a point for each point of regard."
            },
            "act": {
              "kind": "ref",
              "to": "act"
            }
          }
        }
      }
    },
    "boss": {
      "kind": "group",
      "description": "A crew of your own (M4.1, D145): the wholesale connect the supplier can introduce you to, and the terms you set your own recruits, from the people you know (tune).",
      "fields": {
        "connect": {
          "kind": "group",
          "fields": {
            "trust": {
              "kind": "int",
              "min": 1,
              "max": 50,
              "description": "The supplier's trust before they introduce you."
            },
            "heat": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The most heat on you the connect will meet."
            },
            "hours": {
              "kind": "group",
              "fields": {
                "from": {
                  "kind": "int",
                  "min": 0,
                  "max": 23
                },
                "to": {
                  "kind": "int",
                  "min": 1,
                  "max": 24
                }
              }
            },
            "sells": {
              "kind": "list",
              "min": 1,
              "of": {
                "kind": "group",
                "fields": {
                  "id": {
                    "kind": "text",
                    "min": 1,
                    "max": 24
                  },
                  "grams": {
                    "kind": "int",
                    "min": 1,
                    "max": 100000
                  },
                  "price": {
                    "kind": "int",
                    "min": 1,
                    "max": 100000000
                  }
                }
              }
            },
            "most": {
              "kind": "int",
              "min": 1,
              "max": 100000,
              "description": "The most you can hold once you have the connect, in tenths of a gram."
            }
          }
        },
        "crew": {
          "kind": "group",
          "fields": {
            "most": {
              "kind": "int",
              "min": 1,
              "max": 12,
              "description": "Recruits at once."
            },
            "regard": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Their regard for you needed for a yes."
            },
            "familiarity": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "How well you must know them."
            },
            "front": {
              "kind": "group",
              "fields": {
                "grams": {
                  "kind": "int",
                  "min": 1,
                  "max": 10000
                },
                "price": {
                  "kind": "int",
                  "min": 1,
                  "max": 10000000
                },
                "days": {
                  "kind": "int",
                  "min": 1,
                  "max": 60
                }
              }
            },
            "nights": {
              "kind": "int",
              "min": 1,
              "max": 7,
              "description": "Nights a week each sells."
            },
            "buyers": {
              "kind": "int",
              "min": 1,
              "max": 95,
              "description": "The odds in percent of a buyer in each of their ten minutes, through a night's four hours."
            },
            "seen": {
              "kind": "int",
              "min": 0,
              "max": 1000,
              "description": "The odds in a thousand one of their sales is seen: about 3 arrests in a hundred weeks' selling for each (Levitt and Venkatesh, 5.9 in four years)."
            },
            "named": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Taken in, the odds in percent they name you, less their regard for you."
            }
          }
        }
      }
    },
    "rivals": {
      "kind": "group",
      "description": "Rival crews on corners (M4.1 step 2, D148): how many corners they hold, the warnings before trouble, and how long trouble keeps you off (tune).",
      "fields": {
        "held": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "The odds in percent a corner is held by a rival crew in a four-week stretch."
        },
        "warnings": {
          "kind": "int",
          "min": 0,
          "max": 10,
          "description": "Warnings on a held corner before trouble."
        },
        "off": {
          "kind": "int",
          "min": 1,
          "max": 60,
          "description": "Days run off a corner after trouble."
        }
      }
    },
    "violence": {
      "kind": "group",
      "description": "Violence in the trade (M4.1 step 3, D146): rare and costly. Odds in percent, money in cents (tune).",
      "fields": {
        "hurt": {
          "kind": "text",
          "min": 1,
          "max": 24,
          "description": "The illness kind a beating is (illness record)."
        },
        "robbed": {
          "kind": "group",
          "description": "Robbed on the corner: odds an hour, more for what you hold and on a held corner; what is taken; the odds you are hurt.",
          "fields": {
            "base": {
              "kind": "int",
              "min": 0,
              "max": 50,
              "description": "Odds an hour on an open corner."
            },
            "per": {
              "kind": "int",
              "min": 1,
              "max": 100000,
              "description": "A point more for every this many tenths of a gram held."
            },
            "held": {
              "kind": "int",
              "min": 0,
              "max": 50,
              "description": "Points more on a held corner."
            },
            "most": {
              "kind": "int",
              "min": 1,
              "max": 95,
              "description": "The most the odds can be."
            },
            "cash": {
              "kind": "int",
              "min": 0,
              "max": 10000000,
              "description": "The most cash taken."
            },
            "hurt": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The odds you are hurt."
            }
          }
        },
        "trouble": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "The odds being run off a held corner comes with a beating."
        },
        "cutOff": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "The odds the supplier's people beat you when a front goes unpaid."
        },
        "collect": {
          "kind": "group",
          "description": "Collecting an unpaid front from your crew by force.",
          "fields": {
            "win": {
              "kind": "int",
              "min": 1,
              "max": 99,
              "description": "The odds you get the money."
            },
            "hurt": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Winning, the odds they are hurt."
            },
            "yours": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Losing, the odds you are hurt."
            },
            "reported": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The odds they report it."
            },
            "assault": {
              "kind": "ref",
              "to": "offence",
              "description": "Charged when they are not hurt."
            },
            "aggravated": {
              "kind": "ref",
              "to": "offence",
              "description": "Charged when they are."
            }
          }
        },
        "rob": {
          "kind": "group",
          "description": "Robbing a rival crew's seller on a held corner.",
          "fields": {
            "win": {
              "kind": "int",
              "min": 1,
              "max": 99,
              "description": "The odds you get away with it."
            },
            "min": {
              "kind": "int",
              "min": 0,
              "max": 10000000,
              "description": "Cash taken, at least."
            },
            "max": {
              "kind": "int",
              "min": 0,
              "max": 10000000,
              "description": "Cash taken, at most."
            },
            "yours": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Losing, the odds you are hurt."
            },
            "seen": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "The odds it is reported, either way."
            },
            "heat": {
              "kind": "int",
              "min": 0,
              "max": 100,
              "description": "Heat it draws."
            },
            "robbery": {
              "kind": "ref",
              "to": "offence",
              "description": "What it is charged as."
            }
          }
        },
        "contest": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "The odds of winning at trial on a reported assault or robbery."
        }
      }
    },
    "cash": {
      "kind": "group",
      "description": "Cash the trade made (M4.1 step 4, D147): what draws attention, and how much.",
      "fields": {
        "notice": {
          "kind": "int",
          "min": 0,
          "max": 100000000,
          "description": "Cents of the trade's money in hand before it draws attention."
        },
        "heat": {
          "kind": "int",
          "min": 0,
          "max": 100,
          "description": "Heat a day while it is over that."
        }
      }
    }
  }
}
