        "kind": "ref",
        "to": "offence"
      },
      "description": "What it is charged as: the first that covers the value and the convictions already on your record."
    },
    "bars": {
      "kind": "bool",
      "description": "Whether a shop that catches you bars you from it for good, as a trespass notice does (tune)."
    },
    "noticed": {
      "kind": "group",
      "description": "The odds in percent of being noticed taking something, by what sees where you stand (D45). A camera's are the odds the footage is reviewed and you are known.",
      "fields": {
        "clerk": {
          "kind": "int",
          "min": 1,
          "max": 95
        },
        "camera": {
          "kind": "int",
          "min": 1,
          "max": 95
        },
        "unseen": {
          "kind": "int",
          "min": 1,
          "max": 95
        }
      }
    },
